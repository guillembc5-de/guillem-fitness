<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Permiso de Salud (solo lectura de pasos) para Sideloadly:
  Advanced Options → Use custom entitlements → este archivo.
  Es el mismo permiso que ya lleva la app; sirve para que Sideloadly no lo quite al firmar.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.developer.healthkit</key>
    <true/>
  </dict>
</plist>
